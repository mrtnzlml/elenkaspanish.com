---
import Layout from "../../layouts/Layout.astro";
import { games } from "../../data/games";
---

<Layout
  title="Games — Spanish with Elena Ramón"
  description="Free Spanish practice games: flashcards, hangman, verb conjugation, listening quizzes, and more. Learn vocabulary and grammar with Elenka Spanish."
>
  <section class="max-w-4xl mx-auto px-6 py-16">
    <div class="text-center mb-10">
      <div class="w-20 h-20 bg-primary/10 rounded-2xl flex items-center justify-center mx-auto mb-5">
        <svg class="w-10 h-10 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 11h4M8 9v4M15 12h.01M18 10h.01" />
          <rect x="2" y="6" width="20" height="12" rx="4" />
        </svg>
      </div>
      <h1 class="text-3xl md:text-4xl font-bold text-primary mb-2">
        Practice Games
      </h1>
      <p class="text-gray-500">
        Fun ways to build your Spanish vocabulary, grammar, and listening skills.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        games.map((game) => (
          <a
            href={game.href}
            class="group p-6 rounded-xl border border-gray-200 bg-white shadow-sm hover:border-primary/40 hover:shadow-lg hover:-translate-y-0.5 transition-all flex flex-col"
          >
            <div class:list={["w-12 h-12 rounded-xl flex items-center justify-center mb-4 text-2xl group-hover:scale-110 transition-transform", game.color]}>
              <span aria-hidden="true" set:html={game.icon} />
            </div>
            <h2 class="text-lg font-bold mb-2 group-hover:text-primary transition-colors">
              {game.title}
            </h2>
            <p class="text-sm text-gray-500 flex-1">{game.description}</p>
          </a>
        ))
      }
    </div>

    <div class="mt-16 pt-10 border-t border-gray-200 text-center">
      <p class="text-gray-600 mb-5">Want to learn faster with a personal teacher?</p>
      <a
        href="https://calendar.google.com/calendar/u/0/appointments/schedules/AcZssZ38hp0IO46XB7FQXk_vZXUAaaMVejyjSFGxa-NanSFJbN9S2_Asp_kl-_YddbRWDI3HbtKwGgcW"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-primary text-white px-8 py-4 rounded-xl font-bold shadow-lg shadow-primary/20 hover:bg-primary-dark transition-colors"
      >
        Book a free intro call with Elena
      </a>
    </div>
  </section>
</Layout>
