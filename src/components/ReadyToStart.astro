---
import EsTip from "./EsTip.astro";

const bookingUrl =
  "https://calendar.google.com/calendar/u/0/appointments/schedules/AcZssZ38hp0IO46XB7FQXk_vZXUAaaMVejyjSFGxa-NanSFJbN9S2_Asp_kl-_YddbRWDI3HbtKwGgcW";
---

<section class="relative overflow-hidden text-center text-white">
  <picture aria-hidden="true">
    <source srcset="/calle.avif" type="image/avif" />
    <source srcset="/calle.webp" type="image/webp" />
    <img src="/calle.jpg" alt="" loading="lazy" decoding="async" class="absolute inset-0 w-full h-full object-cover object-[center_40%]" />
  </picture>
  <div class="absolute inset-0" aria-hidden="true" style="background:linear-gradient(120deg,rgba(0,45,140,.9),rgba(150,16,82,.78) 55%,rgba(120,60,8,.8))"></div>
  <div class="relative max-w-4xl mx-auto px-6 py-20">
    <p class="mb-3" style="font-family:var(--font-serif);font-style:italic;color:rgba(255,255,255,.92)"><EsTip en="Ready to start?">¿Listo para empezar?</EsTip></p>
    <h2 class="text-2xl md:text-3xl font-bold mb-8">Ready to Start Your Spanish Adventure?</h2>
    <a href={bookingUrl} target="_blank" rel="noopener noreferrer"
       class="inline-block bg-white text-primary px-8 py-4 rounded-[14px] font-bold hover:bg-gray-100 transition-all shadow-[0_14px_30px_rgba(0,0,0,.25)]">
      Schedule a free 20-minute call
    </a>
  </div>
</section>
