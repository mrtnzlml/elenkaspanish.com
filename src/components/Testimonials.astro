---
import EsTip from "./EsTip.astro";
import TestimonialCard from "./TestimonialCard.astro";
import { testimonials, splitLead, VISIBLE_COUNT } from "../data/testimonials";

const featured = testimonials.find((t) => t.featured);
const spot = featured && splitLead(featured.quote);
const rest = testimonials.filter((t) => !t.featured);
const visible = rest.slice(0, VISIBLE_COUNT);
const hidden = rest.slice(VISIBLE_COUNT);
// Text-safe accents only (white initials on them pass AA).
const avatarColors = ["bg-primary", "bg-rosa", "bg-teal-dark", "bg-terracotta"];
const avatar = (i: number) => avatarColors[i % avatarColors.length];
// Cards keep the colour each student has in the avatar stack.
const avatarFor = (t: (typeof testimonials)[number]) => avatar(testimonials.indexOf(t));
---

<section id="testimonials" class="tint-teal py-16">
  <div class="max-w-7xl mx-auto px-6">
    <h2 class="text-2xl md:text-3xl font-bold text-center text-primary mb-3">
      What My Students Say
    </h2>
    <p class="flex items-center justify-center gap-3 mb-12">
      <span class="w-8 h-px bg-teal/40" aria-hidden="true"></span>
      <span class="text-base" style="font-family:var(--font-serif);font-style:italic;color:var(--color-teal-dark)"><EsTip en="What my students say">Lo que dicen mis alumnos</EsTip></span>
      <span class="w-8 h-px bg-teal/40" aria-hidden="true"></span>
    </p>

    <div class="grid lg:grid-cols-[5fr_7fr] gap-10 lg:gap-14">
      <!-- Spotlight: sticks beside the cards on desktop. Needs <main> to clip
           with overflow-x-clip, not overflow-hidden, or sticky stops working. -->
      {featured && spot && (
        <figure id="testimonial-spotlight" class="lg:sticky lg:top-24 self-start">
          <blockquote>
            <p class="text-3xl md:text-4xl leading-tight text-primary mb-5" style="font-family:var(--font-serif);font-style:italic">&ldquo;{spot.lead}{spot.rest.length === 0 && "”"}</p>
            {spot.rest.map((p, i) => (
              <p class="text-gray-600 leading-relaxed mt-3 first:mt-0">{p}{i === spot.rest.length - 1 && "”"}</p>
            ))}
          </blockquote>
          <figcaption class="flex items-center gap-3 mt-6 font-bold text-gray-800">
            <span class={`w-10 h-10 rounded-full grid place-items-center text-white ${avatarFor(featured)}`} aria-hidden="true">{featured.name[0]}</span>
            {featured.name}
          </figcaption>
          <div class="flex items-center gap-4 mt-8 pt-6 border-t border-teal/25">
            <div class="flex shrink-0" aria-hidden="true">
              {testimonials.map((t, i) => (
                <span class={`w-9 h-9 -ml-2.5 first:ml-0 rounded-full grid place-items-center text-sm font-bold text-white border-[3px] border-white ${avatar(i)}`}>{t.name[0]}</span>
              ))}
            </div>
            <p class="text-gray-800">{testimonials.length} written reviews from over 50 students</p>
          </div>
        </figure>
      )}

      <div>
        <!-- Masonry: CSS columns absorb quotes of very different lengths without JS. -->
        <div class="md:columns-2 gap-6">
          {visible.map((t) => <TestimonialCard testimonial={t} avatarClass={avatarFor(t)} />)}
        </div>
        {hidden.length > 0 && (
          <details class="group">
            <summary class="mx-auto w-fit list-none cursor-pointer px-6 py-3 rounded-lg font-bold text-primary border border-primary/20 bg-white hover:bg-primary/5 [&::-webkit-details-marker]:hidden">
              <span class="group-open:hidden">Show {hidden.length} more {hidden.length === 1 ? "review" : "reviews"}</span>
              <span class="hidden group-open:inline">Show fewer reviews</span>
            </summary>
            <div class="md:columns-2 gap-6 mt-6">
              {hidden.map((t) => <TestimonialCard testimonial={t} avatarClass={avatarFor(t)} />)}
            </div>
          </details>
        )}
      </div>
    </div>
  </div>
</section>
